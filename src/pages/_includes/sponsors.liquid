<div class="fg section sponsors">
  <div class="fg-12">
    <h2 class="bg-shiny">{{ sponsors.year }} Sponsors</h2>
    <p>Want to be a sponsor? <a href="https://www.zeffy.com/en-US/donation-form/donate-to-change-lives-13149">Make a donation online!</a></p>
  </div>
  {% assign data = sponsors.years | where: "year", sponsors.year %}
  {% assign modulo = data[0].categories.size | modulo: 2 %}
  {% for category in data[0].categories %}
    {% if forloop.last and modulo == 1 %}
      {% assign classes = "fg-12 fg-lg-12 sponsors-wrap-wide" %}
    {% else %}
      {% assign classes = "fg-12 fg-lg-6" %}
    {% endif %}
    <div class="{{ classes }} sponsors-wrap sponsor-list sponsors-{{ category.key }}">
      <h4 class="sponsor-bg bg-{{ category.key }} bg-shiny">{{ category.title }}</h4>
      <h5>{{ category.description }}</h5>
      <ul>
        {% for sponsor in data[0].sponsors -%}
          {% if sponsor.level != category.key %}
            {% continue %}
          {% endif -%}
          <li>
            {% if sponsor.url -%}
              <a class="sponsor-name" href="{{ sponsor.url }}">{{ sponsor.name }}</a>
            {%- else -%}
              <span class="sponsor-name">{{ sponsor.name }}</span>
            {%- endif -%}
            {% if sponsor.image -%}
              {% if sponsor.url -%}
                <a class="sponsor-img-link" href="{{ sponsor.url }}">
                  <img class="sponsor-img" src="/images/sponsors/{{ sponsor.image }}" alt="{{ sponsor.name }}">
                </a>
              {% else -%}
                <img class="sponsor-img" src="/images/sponsors/{{ sponsor.image }}" alt="{{ sponsor.name }}">
              {% endif -%}
            {% endif -%}
            {%- if sponsor.location -%}
              <span class="sponsor-location">{{ sponsor.location }}</span>
            {% endif -%}
          </li>
        {% endfor -%}
      </ul>
    </div>
  {% endfor %}
</div>
